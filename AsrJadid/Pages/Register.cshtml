@page
@model RegisterModel
@{
    ViewData["Title"] = "ثبت‌نام";
}

<section class="auth-page">
    <div class="container auth-layout">
        <div class="auth-card card">
            <div class="auth-head">
                <span class="auth-logo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 8 6-8 12L4 9l8-6Z" /><path d="M4 9h16" /></svg></span>
                <h1>ساخت حساب کاربری</h1>
                <p>در چند ثانیه ثبت‌نام کنید و از قیمت‌های اختصاصی و پیگیری سفارش بهره‌مند شوید.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="notice-bar"><p>@Model.ErrorMessage</p></div>
            }

            <form class="form" method="post">
                <div class="form-grid">
                    <div class="field">
                        <label>نام <span class="req">*</span></label>
                        <input asp-for="Input.Name" required>
                        <span class="muted">@Html.ValidationMessageFor(x => x.Input.Name)</span>
                    </div>
                    <div class="field">
                        <label>نام خانوادگی <span class="req">*</span></label>
                        <input asp-for="Input.Family" required>
                        <span class="muted">@Html.ValidationMessageFor(x => x.Input.Family)</span>
                    </div>
                </div>
                <div class="field">
                    <label>شماره همراه <span class="req">*</span></label>
                    <div class="input-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.4 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z" /></svg>
                        <input asp-for="Input.PhoneNumber" type="tel" placeholder="۰۹۱۵۹۸۶۱۲۱۶" inputmode="numeric" required>
                    </div>
                    <span class="muted">@Html.ValidationMessageFor(x => x.Input.PhoneNumber)</span>
                </div>
                <div class="field">
                    <label>ایمیل</label>
                    <div class="input-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m2 7 10 6 10-6" /></svg>
                        <input asp-for="Input.Email" type="email" placeholder="you@example.com">
                    </div>
                </div>
                <div class="form-grid">
                    <div class="field">
                        <label>رمز عبور <span class="req">*</span></label>
                        <input asp-for="Input.Password" type="password" required autocomplete="new-password">
                        <span class="muted">@Html.ValidationMessageFor(x => x.Input.Password)</span>
                    </div>
                    <div class="field">
                        <label>تکرار رمز عبور <span class="req">*</span></label>
                        <input asp-for="Input.RePassword" type="password" required autocomplete="new-password">
                        <span class="muted">@Html.ValidationMessageFor(x => x.Input.RePassword)</span>
                    </div>
                </div>
                <label class="check-row"><input type="checkbox" asp-for="Input.AcceptTerms" required><span>قوانین و مقررات و <a asp-page="/Privacy" class="link">سیاست حریم خصوصی</a> را می‌پذیرم.</span></label>
                <button class="btn btn-primary btn-block btn-lg" type="submit">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8 12 3 3 5-6" /></svg> تکمیل ثبت‌نام
                </button>
            </form>

            <p class="auth-foot">قبلاً ثبت‌نام کرده‌اید؟ <a asp-page="/Login" class="link">ورود به حساب</a></p>
        </div>
        <aside class="auth-aside">
            <img src="~/assets/images/hero-1.jpg" alt="عصرجدید">
            <div class="aa-body">
                <h2>چرا عصرجدید؟</h2>
                <ul class="check-list check-light">
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8 12 3 3 5-6" /></svg> ۱۹ سال سابقه تولید و بیش از ۴۲۰ پروژه اجراشده</li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8 12 3 3 5-6" /></svg> ضمانت‌نامه کتبی و پشتیبانی فنی رایگان</li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8 12 3 3 5-6" /></svg> ارسال به سراسر کشور با بیمه کامل بار</li>
                </ul>
            </div>
        </aside>
    </div>
</section>
