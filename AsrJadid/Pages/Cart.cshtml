@page
@model CartModel
@{
    ViewData["Title"] = "سبد خرید";
    ViewData["BodyClass"] = "page-cart";
}

<section class="page-hero">
    <div class="container">
        <div class="ph-inner">
            <h1 class="ph-title">سبد خرید</h1>
            <p class="ph-sub" id="cartCount">در حال بارگذاری سبد خرید…</p>
        </div>
    </div>
</section>
<nav class="breadcrumb-wrap" aria-label="مسیر صفحه">
    <div class="container">
        <ol class="breadcrumb"><li><a asp-page="/Index">صفحه اصلی</a></li><li aria-current="page">سبد خرید</li></ol>
    </div>
</nav>
<section class="section">
    <div class="container">
        <div class="cart-steps">
            <span class="cs-item active"><i>۱</i> سبد خرید</span>
            <span class="cs-line"></span>
            <span class="cs-item"><i>۲</i> اطلاعات ارسال</span>
            <span class="cs-line"></span>
            <span class="cs-item"><i>۳</i> پرداخت</span>
            <span class="cs-line"></span>
            <span class="cs-item"><i>۴</i> سفارش کامل</span>
        </div>

        <div class="empty-state" id="cartEmpty" hidden>
            <h3>سبد خرید شما خالی است</h3>
            <p class="muted">هنوز محصولی به سبد خرید اضافه نکرده‌اید. از فهرست محصولات، کالای مورد نظر خود را انتخاب کنید.</p>
            <a class="btn btn-primary" asp-page="/Products">مشاهده محصولات</a>
        </div>

        <div class="cart-layout" id="cartWrap" hidden>
            <div class="cart-main">
                <div class="table-wrap card">
                    <table class="table cart-table">
                        <thead><tr><th>محصول</th><th>قیمت واحد</th><th>تعداد</th><th>جمع</th><th></th></tr></thead>
                        <tbody id="cartBody"></tbody>
                    </table>
                </div>
                <div class="cart-coupon">
                    <div class="field"><input type="text" placeholder="کد تخفیف را وارد کنید" aria-label="کد تخفیف"></div>
                    <button class="btn btn-outline" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 6 12 12" /><circle cx="7.5" cy="7.5" r="2" /><circle cx="16.5" cy="16.5" r="2" /></svg> اعمال کد تخفیف</button>
                    <a class="btn btn-ghost" asp-page="/Products"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11A8 8 0 0 0 6 6L4 8M4 13a8 8 0 0 0 14 5l2-2" /><path d="M4 4v4h4M20 20v-4h-4" /></svg> افزودن محصول دیگر</a>
                </div>
            </div>
            <aside class="cart-side">
                <div class="card summary">
                    <h3>خلاصه سفارش</h3>
                    <ul class="sum-list">
                        <li><span>جمع کالاها</span><strong data-cart="subtotal">۰ تومان</strong></li>
                        <li><span>مالیات بر ارزش افزوده (۹٪)</span><strong data-cart="tax">۰ تومان</strong></li>
                        <li><span>هزینه حمل (باربری تخصصی)</span><strong data-cart="shipping">۰ تومان</strong></li>
                        <li class="sum-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 2 20h20L12 3Z" /><path d="M12 9v5m0 3h.01" /></svg> هزینه حمل برای سفارش‌های بالای ۵۰ میلیون تومان رایگان است.</li>
                    </ul>
                    <div class="sum-total"><span>مبلغ قابل پرداخت</span><strong data-cart="total">۰ تومان</strong></div>
                    <a class="btn btn-primary btn-block btn-lg" asp-page="/Checkout"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20M6 15h4" /></svg> ادامه فرآیند خرید</a>
                    <a class="btn btn-ghost btn-block" asp-page="/Products">افزودن محصول دیگر</a>
                </div>
                <div class="card cart-help">
                    <span class="svc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.4 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z" /></svg></span>
                    <h3>سفارش تلفنی</h3>
                    <p>می‌خواهید سفارش خود را تلفنی ثبت کنید؟ کارشناسان ما در ساعات کاری پاسخ‌گو هستند.</p>
                    <a class="btn btn-outline btn-block" href="tel:+989159861216">۰۹۱۵۹۸۶۱۲۱۶</a>
                </div>
            </aside>
        </div>
    </div>
</section>

<section class="section section-soft">
    <div class="container">
        <div class="section-head align-center">
            <div class="sec-text">
                <span class="eyebrow">محصولات پیشنهادی</span>
                <h2 class="sec-title">تکمیل‌کننده‌های سفارش شما</h2>
                <p class="sec-sub">مشتریانی که این محصولات را خریده‌اند، موارد زیر را هم انتخاب کرده‌اند.</p>
            </div>
        </div>
        <div class="grid grid-3 js-products" id="cartSuggest">
@foreach (var item in Model.Suggested)
{
    @await Html.PartialAsync("_ProductCard", item)
}
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/basket-pages.js" asp-append-version="true"></script>
}
