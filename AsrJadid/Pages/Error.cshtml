@page
@model ErrorModel
@{
    ViewData["Title"] = "خطا در پردازش درخواست";
    var status = Model.StatusCode;
    var title = status == 404 ? "صفحه مورد نظر یافت نشد" : "خطایی رخ داد";
    var message = status == 404
        ? "نشانی وارد شده در سایت وجود ندارد یا جابه‌جا شده است. از فهرست زیر می‌توانید مسیر خود را ادامه دهید."
        : "در پردازش درخواست شما مشکلی پیش آمده است. لطفاً چند لحظه بعد دوباره تلاش کنید یا با پشتیبانی تماس بگیرید.";
}

<section class="page-hero">
    <div class="container">
        <div class="ph-inner">
            <h1 class="ph-title">@(status == 404 ? "۴۰۴" : "خطای سرور")</h1>
            <p class="ph-sub">@title</p>
        </div>
    </div>
</section>
<nav class="breadcrumb-wrap" aria-label="مسیر صفحه">
    <div class="container">
        <ol class="breadcrumb"><li><a asp-page="/Index">صفحه اصلی</a></li><li aria-current="page">@title</li></ol>
    </div>
</nav>
<section class="section">
    <div class="container">
        <div class="empty-state">
            <h2>@title</h2>
            <p class="muted">@message</p>
            @if (Model.ShowRequestId)
            {
                <p class="muted">شناسه پیگیری خطا: <code>@Model.RequestId</code></p>
            }
            <div class="form-actions" style="justify-content:center">
                <a class="btn btn-primary" asp-page="/Index">بازگشت به صفحه اصلی</a>
                <a class="btn btn-outline" asp-page="/Products">مشاهده محصولات</a>
                <a class="btn btn-ghost" asp-page="/Contact">تماس با پشتیبانی</a>
            </div>
        </div>
    </div>
</section>
