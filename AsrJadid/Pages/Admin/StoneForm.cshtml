@page "{id:long?}"
@model AsrJadid.Pages.Admin.StoneFormModel
@{
    var isEdit = Model.Input.Id > 0;
    ViewData["Title"] = isEdit ? "ویرایش محصول" : "افزودن محصول";
    ViewData["Crumb"] = isEdit ? "ویرایش اطلاعات محصول" : "ثبت محصول جدید در فروشگاه";
    ViewData["AdminActive"] = "/Admin/Stones";
}

<div class="adm-page-head">
    <div class="adm-page-title">
        <h2>@(isEdit ? "ویرایش محصول" : "افزودن محصول جدید")</h2>
        <p>@(isEdit ? Model.Input.StoneName : "مشخصات فنی، قیمت و تصویر محصول را وارد کنید")</p>
    </div>
    <div class="adm-page-actions">
        <a class="btn btn-outline btn-sm" asp-page="/Admin/Stones">بازگشت به فهرست</a>
        @if (isEdit)
        {
            <a class="btn btn-ghost btn-sm" asp-page="/Product" asp-route-id="@Model.Input.Id">مشاهده در سایت</a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="notice-bar"><p>@Model.ErrorMessage</p></div>
}

<form class="adm-card adm-form" method="post" enctype="multipart/form-data" style="padding:18px">
    <input type="hidden" asp-for="Input.Id" />
    <input type="hidden" asp-for="Input.Picture" />

    <div class="adm-form-grid">
        <div class="field"><label>نام محصول <span class="req">*</span></label><input asp-for="Input.StoneName" required></div>
        <div class="field">
            <label>دسته‌بندی <span class="req">*</span></label>
            <select asp-for="Input.CategoryId" required>
                <option value="0">انتخاب دسته‌بندی…</option>
@foreach (var cat in Model.Categories)
{
    <option value="@cat.Id" selected="@(Model.Input.CategoryId == cat.Id)">@cat.Name</option>
}
            </select>
        </div>
        <div class="field"><label>قیمت هر مترمربع (تومان) <span class="req">*</span></label><input asp-for="Input.Price" type="number" min="0" step="1000" required></div>
        <div class="field"><label>موجودی انبار <span class="req">*</span></label><input asp-for="Input.Stock" type="number" min="0" required></div>
        <div class="field"><label>طول (سانتی‌متر)</label><input asp-for="Input.Length" type="number" step="0.1" min="0"></div>
        <div class="field"><label>عرض (سانتی‌متر)</label><input asp-for="Input.Width" type="number" step="0.1" min="0"></div>
        <div class="field"><label>وزن (کیلوگرم)</label><input asp-for="Input.Weight" type="number" step="0.1" min="0"></div>
        <div class="field"><label>رنگ</label><input asp-for="Input.Color"></div>
        <div class="field full"><label>توضیحات</label><textarea asp-for="Input.Description" rows="4"></textarea></div>
        <div class="field">
            <label>تصویر محصول</label>
            <input asp-for="Input.PictureFile" type="file" accept="image/*">
            <span class="adm-crumb-sub">در صورت انتخاب نشدن، تصویر فعلی حفظ می‌شود. اندازه پیشنهادی ۷۲۰ پیکسل.</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Input.Picture))
        {
            <div class="field">
                <label>تصویر فعلی</label>
                <img src="@Model.Input.Picture.ImageUrl()" alt="تصویر محصول" style="width:180px;border-radius:12px">
            </div>
        }
    </div>

    <div class="adm-inline-actions">
        <button class="btn btn-primary btn-lg" type="submit">@(isEdit ? "ذخیره تغییرات" : "ثبت محصول")</button>
        <a class="btn btn-ghost" asp-page="/Admin/Stones">انصراف</a>
    </div>
</form>
