@page
@model ContactModel
@{
    ViewData["Title"] = "تماس با ما";
    ViewData["Active"] = "contact";
}

<section class="page-hero" style="--ph-img:url(/assets/images/hero-3.jpg)">
  <div class="container">
    <div class="ph-inner">
      <h1 class="ph-title">تماس با ما</h1>
      <p class="ph-sub">پاسخ‌گویی ۷ روز هفته؛ از مشاوره فنی تا پیگیری سفارش</p>
    </div>
  </div>
</section>
<nav class="breadcrumb-wrap" aria-label="مسیر صفحه">
  <div class="container">
    <ol class="breadcrumb"><li><a asp-page="/Index">صفحه اصلی</a></li><li aria-current="page">تماس با ما</li></ol>
  </div>
</nav>
<section class="section">
  <div class="container">
    <div class="contact-cards">
      <a class="contact-card" href="tel:+989159861216"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.4 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg><strong>۰۹۱۵۹۸۶۱۲۱۶</strong><span>واحد فروش و مشاوره فنی</span></a>
      <a class="contact-card" href="mailto:info@@asrjadid.com"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg><strong>info@@asrjadid.com</strong><span>ایمیل رسمی شرکت</span></a>
      <a class="contact-card" href="https://wa.me/989159861216" target="_blank" rel="noopener"><span class="cc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 0 1-11.6 7L4 20l1.2-4A8 8 0 1 1 20 12Z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5"/></svg></span><strong>۰۹۱۵-۹۸۶-۱۲۱۶</strong><span>واتس‌اپ (ارسال نقشه و عکس)</span></a>
      <div class="contact-card"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg><strong>تهران، شهرک صنعتی چهاردانگه</strong><span>کارخانه و نمایشگاه مرکزی</span></div>
    </div>
    <div class="contact-layout">
      <form class="card form-card contact-form" method="post">
        <h2 class="card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.5 7.2L4 21l1.8-5.5A8 8 0 1 1 21 12Z"/></svg> فرم تماس و استعلام قیمت</h2>
        <p class="card-text">فرم زیر را تکمیل کنید؛ کارشناس مربوطه در کمتر از ۲ ساعت کاری با شما تماس می‌گیرد.</p>

        @if (TempData["ContactSuccess"] != null || !string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="notice-bar notice-ok"><p>@(TempData["ContactSuccess"] ?? Model.SuccessMessage)</p></div>
        }

        <div class="form-grid">
          <div class="field"><label>نام و نام خانوادگی <span class="req">*</span></label><input asp-for="Input.FullName" required><span class="muted">@Html.ValidationMessageFor(x => x.Input.FullName)</span></div>
          <div class="field"><label>شماره همراه <span class="req">*</span></label><input asp-for="Input.PhoneNumber" type="tel" required><span class="muted">@Html.ValidationMessageFor(x => x.Input.PhoneNumber)</span></div>
          <div class="field"><label>ایمیل</label><input asp-for="Input.Email" type="email"></div>
          <div class="field"><label>موضوع درخواست</label><select asp-for="Input.Subject">
            <option>استعلام قیمت محصول</option><option>مشاوره فنی و انتخاب طرح</option>
            <option>پیگیری سفارش</option><option>همکاری و نمایندگی</option><option>سایر موارد</option></select></div>
          <div class="field"><label>نوع پروژه</label><select asp-for="Input.ProjectType">
            <option>مسکونی</option><option>تجاری / اداری</option><option>صنعتی</option><option>بازسازی</option></select></div>
          <div class="field"><label>متراژ تقریبی (مترمربع)</label><input asp-for="Input.Area" placeholder="مثلاً ۱۲۰"></div>
          <div class="field full"><label>توضیحات <span class="req">*</span></label><textarea asp-for="Input.Message" rows="5" placeholder="کاربری فضا، طرح مورد نظر، شهر پروژه و زمان‌بندی مورد انتظار را بنویسید…" required></textarea><span class="muted">@Html.ValidationMessageFor(x => x.Input.Message)</span></div>
        </div>
        <label class="check-row"><input type="checkbox" asp-for="Input.AcceptContact" required><span>با ثبت این فرم، با تماس کارشناسان عصرجدید موافقت می‌کنم.</span></label>
        <div class="form-actions"><button class="btn btn-primary btn-lg" type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h11l3 3v15H5z"/><path d="M8 3v6h7V3M8 14h8v7H8z"/></svg> ارسال درخواست</button></div>
      </form>
      <aside class="contact-side">
        <div class="card">
          <h3 class="card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> ساعات کاری</h3>
          <ul class="hours-list">
            <li><span>شنبه تا چهارشنبه</span><strong>۸:۳۰ – ۱۷:۳۰</strong></li>
            <li><span>پنجشنبه</span><strong>۸:۳۰ – ۱۳:۰۰</strong></li>
            <li><span>جمعه</span><strong>تعطیل (پاسخ‌گویی تلفنی اضطراری)</strong></li>
          </ul>
        </div>
        <div class="card">
          <h3 class="card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.6-4.4M8.2 13.2l7.6 4.4"/></svg> راه‌های ارتباط مستقیم</h3>
          <ul class="f-contact-list">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 0 1-11.6 7L4 20l1.2-4A8 8 0 1 1 20 12Z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5"/></svg><a href="https://wa.me/989159861216" target="_blank" rel="noopener">واتس‌اپ: ۰۹۱۵۹۸۶۱۲۱۶</a></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.4 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg><a href="tel:+989159861216">تماس تلفنی: ۰۹۱۵۹۸۶۱۲۱۶</a></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg><a href="mailto:info@asrjadid.com">info@asrjadid.com</a></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.5 7.2L4 21l1.8-5.5A8 8 0 1 1 21 12Z"/></svg><a asp-page="/Contact">ثبت درخواست در همین صفحه</a></li>
          </ul>
        </div>
        <div class="card map-card">
          <h3 class="card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg> موقعیت روی نقشه</h3>
          <div class="map-embed">
            <div class="map-ph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3 3 5v16l6-2 6 2 6-2V3l-6 2-6-2Z"/><path d="M9 3v16M15 5v16"/></svg><strong>نقشه محل کارخانه عصرجدید</strong>
              <small>تهران، بزرگراه فتح، شهرک صنعتی چهاردانگه</small>
              <span class="map-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg> ۳۵٫۴۶۵۸° N، ۵۱٫۱۳۳۲° E</span></div>
          </div>
          <p class="muted">در صفحه واقعی، نقشه تعاملی (Google Maps یا نشان) در همین قاب بارگذاری می‌شود.</p>
        </div>
      </aside>
    </div>
  </div>
</section>
