@page
@model DashboardModel
@{
    ViewData["Title"] = "پنل کاربری";
    ViewData["PanelActive"] = "dashboard";
}

<section class="panel-page">
    <div class="container panel-layout">
        <partial name="_AccountSidebar" />
        <div class="panel-main">
            <div class="panel-head">
                <div>
                    <h1>سلام @Model.DisplayName 👋</h1>
                    <p class="muted">خوش آمدید! وضعیت سفارش‌ها و علاقه‌مندی‌های شما در یک نگاه.</p>
                </div>
                <a class="btn btn-primary" asp-page="/Products"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.5" /><circle cx="18" cy="20" r="1.5" /><path d="M2 3h2.2l2.4 12.2a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 2-1.6L21 7H5" /></svg> خرید جدید</a>
            </div>

            <div class="panel-cards">
                <div class="p-card"><span class="pc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.5" /><circle cx="18" cy="20" r="1.5" /><path d="M2 3h2.2l2.4 12.2a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 2-1.6L21 7H5" /></svg></span><div><strong id="dbOrdersCount">۰</strong><small>سفارش ثبت‌شده</small></div></div>
                <div class="p-card"><span class="pc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-9.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 7 3.5C19 15.6 12 20 12 20Z" /></svg></span><div><strong id="dbWishCount">۰</strong><small>محصول در علاقه‌مندی</small></div></div>
                <div class="p-card"><span class="pc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h12v4" /><rect x="3" y="7" width="18" height="12" rx="2" /><path d="M17 13h.01" /></svg></span><div><strong>@Model.Account?.PhoneNumber</strong><small>شماره همراه حساب</small></div></div>
                <div class="p-card"><span class="pc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11h16v10H4zM2 7h20v4H2zM12 7v14" /><path d="M12 7S10 3 7.5 3.6 8 7 12 7s4.5-3 2-3.6S12 7 12 7Z" /></svg></span><div><strong>@(Model.Account?.IsActive == true ? "فعال" : "غیرفعال")</strong><small>وضعیت حساب کاربری</small></div></div>
            </div>

            <div class="grid grid-2">
                <div class="card">
                    <div class="card-head-row">
                        <h3 class="card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.5" /><circle cx="18" cy="20" r="1.5" /><path d="M2 3h2.2l2.4 12.2a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 2-1.6L21 7H5" /></svg> آخرین سفارش‌ها</h3>
                        <a class="link-more" asp-page="/Orders">همه سفارش‌ها <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7" /></svg></a>
                    </div>
                    <div id="dbRecent">
                        <div class="empty-state"><p class="muted">هنوز سفارشی ثبت نشده است.</p><a class="btn btn-primary btn-sm" asp-page="/Products">مشاهده محصولات</a></div>
                    </div>
                </div>
                <div class="card">
                    <h3 class="card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6" /></svg> اطلاعات حساب</h3>
                    <ul class="sum-list">
                        <li><span>نام و نام خانوادگی</span><strong>@Model.DisplayName</strong></li>
                        <li><span>شماره همراه</span><strong>@Model.Account?.PhoneNumber</strong></li>
                        <li><span>ایمیل</span><strong>@(string.IsNullOrWhiteSpace(Model.Account?.Email) ? "ثبت نشده" : Model.Account!.Email)</strong></li>
                        <li><span>نقش کاربری</span><strong>@(string.IsNullOrWhiteSpace(Model.Account?.Role) ? "کاربر" : Model.Account!.Role)</strong></li>
                        <li><span>تاریخ عضویت</span><strong>@(Model.Account == null ? "-" : Model.Account.CreateDateTime.ToFarsi())</strong></li>
                    </ul>
                    <a class="btn btn-outline btn-block" asp-page="/Profile">ویرایش اطلاعات حساب</a>
                </div>
            </div>

            <div class="card">
                <div class="card-head-row">
                    <h3 class="card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 8 6-8 12L4 9l8-6Z" /><path d="M4 9h16" /></svg> محصولات پیشنهادی برای شما</h3>
                    <a class="link-more" asp-page="/Products">فهرست کامل محصولات <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7" /></svg></a>
                </div>
                <div class="grid grid-3">
@foreach (var item in Model.Suggested)
{
    @await Html.PartialAsync("_ProductCard", item)
}
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/basket-pages.js" asp-append-version="true"></script>
}
