@page
@using Services.Application
@model ProductsModel
@{
    ViewData["Title"] = "محصولات";
    ViewData["Active"] = "products";
}

<section class="page-hero" style="--ph-img:url(/assets/images/p-1.jpg)">
  <div class="container">
    <div class="ph-inner">
      <h1 class="ph-title">@(string.IsNullOrWhiteSpace(Model.Query) ? "محصولات عصرجدید" : "نتایج جستجو برای «" + Model.Query + "»")</h1>
      <p class="ph-sub">۱۲ محصول منتخب از ۱۶۱ طرح و رنگ؛ با فیلتر سریع محصول مناسب پروژه را پیدا کنید</p>
    </div>
  </div>
</section>
<nav class="breadcrumb-wrap" aria-label="مسیر صفحه">
  <div class="container">
    <ol class="breadcrumb"><li><a asp-page="/Index">صفحه اصلی</a></li><li aria-current="page">محصولات</li></ol>
  </div>
</nav>
<section class="section">
  <div class="container shop-layout">
    <aside class="shop-side">
      <div class="side-card">
        <button class="side-title js-side-toggle" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"/></svg> دسته‌بندی محصولات <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></i></button>
        <div class="side-body">
@foreach (var cat in Model.Categories)
{
<label class="check-row">
    <input type="checkbox" class="js-filter-cat" value="@cat.Slug">
    <span>@cat.Name</span><small>(@cat.StoneCount.ToPersianNumber())</small>
</label>
}
</div>
      </div>
      <div class="side-card">
        <button class="side-title js-side-toggle" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h12v4"/><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M17 13h.01"/></svg> محدوده قیمت <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></i></button>
        <div class="side-body">
          <div class="price-range">
            <div class="field"><input type="text" id="priceFrom" placeholder="از (تومان)" inputmode="numeric" aria-label="حداقل قیمت"></div>
            <span class="dash">—</span>
            <div class="field"><input type="text" id="priceTo" placeholder="تا (تومان)" inputmode="numeric" aria-label="حداکثر قیمت"></div>
          </div>
          <div class="range-presets">
            <button type="button" class="chip-btn js-range" data-from="0" data-to="500000">تا ۵۰۰ هزار</button>
            <button type="button" class="chip-btn js-range" data-from="500000" data-to="2000000">۵۰۰ هزار تا ۲ میلیون</button>
            <button type="button" class="chip-btn js-range" data-from="2000000" data-to="20000000">بالای ۲ میلیون</button>
          </div>
          <button class="btn btn-outline btn-block js-apply-price" type="button">اعمال فیلتر قیمت</button>
        </div>
      </div>
      <div class="side-card">
        <button class="side-title js-side-toggle" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 6 12 12"/><circle cx="7.5" cy="7.5" r="2"/><circle cx="16.5" cy="16.5" r="2"/></svg> رنگ‌بندی <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></i></button>
        <div class="side-body"><div class="color-list">
@foreach (var color in Model.Colors)
{
<button class="color-chip" type="button" title="@color" data-color="@color"><span></span>@color</button>
}
</div></div>
      </div>
      <div class="side-card">
        <button class="side-title js-side-toggle" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5v-9Z"/><path d="m3 7.5 9 4.5 9-4.5M12 12v9"/></svg> موجودی انبار <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></i></button>
        <div class="side-body">
            <label class="check-row"><input type="checkbox" class="js-filter-stock"><span>فقط کالاهای موجود</span></label>
            <p class="side-note">محصولات ناموجود هم در فهرست می‌مانند تا زمان تأمین را ببینید.</p>
          </div>
      </div>
      <div class="side-card side-help">
        <span class="svc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.5 7.2L4 21l1.8-5.5A8 8 0 1 1 21 12Z"/></svg></span>
        <h3>کمک به انتخاب محصول؟</h3>
        <p>کارشناسان ما در ساعات کاری پاسخ‌گوی شما هستند.</p>
        <a class="btn btn-primary btn-block" href="tel:+989159861216"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.4 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg> ۰۹۱۵۹۸۶۱۲۱۶</a>
      </div>
    </aside>
    <div class="shop-main">
      <div class="toolbar">
        <div class="toolbar-right">
          <span class="tb-count js-result-count">@Model.Products.Count.ToPersianNumber() محصول</span>
          <button class="chip-btn js-clear-filters" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11A8 8 0 0 0 6 6L4 8M4 13a8 8 0 0 0 14 5l2-2"/><path d="M4 4v4h4M20 20v-4h-4"/></svg> حذف فیلترها</button>
        </div>
        <div class="toolbar-left">
          <label class="sort-select">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16m0 0-3-3m3 3 3-3M17 20V4m0 0-3 3m3-3 3 3"/></svg>
            <select class="js-sort" aria-label="ترتیب نمایش">
              <option value="default">مرتب‌سازی: پیش‌فرض</option>
              <option value="cheap">ارزان‌ترین</option>
              <option value="expensive">گران‌ترین</option>
              <option value="new">جدیدترین</option>
              <option value="popular">محبوب‌ترین</option>
            </select>
          </label>
          <div class="view-toggle">
            <button class="chip-btn active js-view" type="button" data-view="grid" title="نمایش شبکه‌ای"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"/></svg></button>
            <button class="chip-btn js-view" type="button" data-view="list" title="نمایش لیستی"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01"/></svg></button>
          </div>
        </div>
      </div>
      <div class="active-filters js-active-filters"></div>
      <div class="grid grid-3 js-products" id="productsGrid">
@foreach (var item in Model.Products)
{
    @await Html.PartialAsync("_ProductCard", item)
}
</div>
      <div class="empty-state" id="noResult" hidden>
        <span class="es-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></span>
        <h3>محصولی با این فیلترها پیدا نشد</h3>
        <p>فیلترها را تغییر دهید یا با کارشناسان ما تماس بگیرید تا محصول سفارشی تولید کنیم.</p>
        <button class="btn btn-primary js-clear-filters" type="button">حذف فیلترها</button>
      </div>
    </div>
  </div>
</section>
<section class="feature-strip"><div class="container feature-grid"><div class="feature"><span class="feat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 4h11v11H1zM12 8h5l3 3.5V15h-8z"/><circle cx="5.5" cy="17.5" r="2"/><circle cx="16.5" cy="17.5" r="2"/></svg></span><span class="feat-body"><strong>ارسال به سراسر کشور</strong><small>ارسال بار با باربری تخصصی و بیمه کامل محموله</small></span></div><div class="feature"><span class="feat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z"/><path d="m9 12 2 2 4-4"/></svg></span><span class="feat-body"><strong>ضمانت اصالت کالا</strong><small>۱۸ ماه ضمانت‌نامه کتبی برای همه محصولات تولیدی</small></span></div><div class="feature"><span class="feat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 15 15 3l6 6L9 21z"/><path d="m7 11 2 2M10 8l2 2M13 5l2 2"/></svg></span><span class="feat-body"><strong>مشاوره و اندازه‌گیری</strong><small>کارشناسان ما به‌صورت رایگان بازدید و متراژ می‌گیرند</small></span></div><div class="feature"><span class="feat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 13 9 5 9-5"/></svg></span><span class="feat-body"><strong>تنوع رنگ و طرح</strong><small>بیش از ۹۰ طرح و رنگ در ۶ گروه محصولی مختلف</small></span></div></div></section>
<section class="cta-band">
  <div class="container cta-inner">
    <div class="cta-text">
      <span class="eyebrow eyebrow-light"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v4m0 10v4M3 12h4m10 0h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18"/></svg> عصرجدید</span>
      <h2>طرح مورد نظر را پیدا نکردید؟</h2>
      <p>برای سفارش‌های بالای ۵۰ مترمربع، تولید رنگ و طرح سفارشی انجام می‌دهیم.</p>
      <div class="cta-actions">
      <a class="btn btn-primary btn-lg" asp-page="/Contact">درخواست مشاوره</a>
      <a class="btn btn-outline btn-lg" asp-page="/PriceList">دریافت لیست قیمت</a>
    </div>
    </div>
    <ul class="cta-points">
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg> بازدید و اندازه‌گیری رایگان در تهران و کرج</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg> برش CNC طبق نقشه پروژه با تلرانس ±۰٫۵ میلی‌متر</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg> ضمانت‌نامه کتبی ۱۸ ماهه و ضمانت سطح کوارتز ۱۰ ساله</li>
    </ul>
  </div>
</section>
