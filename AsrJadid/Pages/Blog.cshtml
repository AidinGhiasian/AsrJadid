@page
@model BlogModel
@{
    ViewData["Title"] = "وبلاگ";
    ViewData["Active"] = "blog";
}

<section class="page-hero" style="--ph-img:url(/assets/images/hero-2.jpg)">
  <div class="container">
    <div class="ph-inner">
      <h1 class="ph-title">وبلاگ عصرجدید</h1>
      <p class="ph-sub">مقالات تخصصی سنگ مصنوعی، راهنمای خرید، مقایسه محصولات و نکات اجرایی</p>
    </div>
  </div>
</section>
<nav class="breadcrumb-wrap" aria-label="مسیر صفحه">
  <div class="container">
    <ol class="breadcrumb"><li><a asp-page="/Index">صفحه اصلی</a></li><li aria-current="page">وبلاگ</li></ol>
  </div>
</nav>
<section class="section">
  <div class="container">
    <article class="post-featured">
      <a class="pf-media" asp-page="/Article"><img src="~/assets/images/p-2.jpg" alt="۵ نکته کلیدی در انتخاب سنگ مصنوعی برای نمای ساختمان"></a>
      <div class="pf-body">
        <span class="badge badge-primary">راهنمای خرید</span>
        <h2 class="pf-title"><a asp-page="/Article">۵ نکته کلیدی در انتخاب سنگ مصنوعی برای نمای ساختمان</a></h2>
        <div class="card-meta"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg> مهندس سعید رضایی</span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg> ۱۴۰۴/۰۶/۱۲</span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> ۶ دقیقه</span></div>
        <p>جذب آب، مقاومت UV، ضخامت، سیستم نصب و ضمانت؛ این پنج معیار تعیین می‌کند نمای ساختمان شما سال‌ها بدرخشد یا در چند سال نخست دچار ترک و تغییر رنگ شود.</p>
        <a class="btn btn-primary" asp-page="/Article">خواندن مقاله <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7"/></svg></a>
      </div>
    </article>
    <div class="grid grid-3 js-blog"><article class="card blog-card" data-cat="مقایسه محصول"><a class="card-media" asp-page="/Article"><img src="~/assets/images/p-10.jpg" alt="کورین یکپارچه یا کوارتز؟ راهنمای انتخاب صفحه آشپزخانه" loading="lazy"><span class="badge badge-soft">مقایسه محصول</span></a><div class="card-body"><div class="card-meta"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg> ۱۴۰۴/۰۵/۲۸</span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> ۸ دقیقه</span></div><h3 class="card-title"><a asp-page="/Article">کورین یکپارچه یا کوارتز؟ راهنمای انتخاب صفحه آشپزخانه</a></h3><p class="card-text">برای آشپزخانه‌ای که زیاد آشپزی می‌کنید کوارتز بهتر است یا کورین؟ در این مطلب تفاوت‌ها را بر اساس حرارت، خط‌وخش، اتصال و …</p><a class="link-more" asp-page="/Article">ادامه مطلب <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7"/></svg></a></div></article><article class="card blog-card" data-cat="نگهداری"><a class="card-media" asp-page="/Article"><img src="~/assets/images/cat-4.jpg" alt="روش‌های صحیح نگهداری از سطوح سنگ مصنوعی" loading="lazy"><span class="badge badge-soft">نگهداری</span></a><div class="card-body"><div class="card-meta"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg> ۱۴۰۴/۰۵/۰۹</span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> ۴ دقیقه</span></div><h3 class="card-title"><a asp-page="/Article">روش‌های صحیح نگهداری از سطوح سنگ مصنوعی</a></h3><p class="card-text">سنگ مصنوعی نیازی به نگهداری پیچیده ندارد؛ اما چند عادت ساده می‌تواند عمر سطح را چند برابر کند.…</p><a class="link-more" asp-page="/Article">ادامه مطلب <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7"/></svg></a></div></article><article class="card blog-card" data-cat="دانستنی"><a class="card-media" asp-page="/Article"><img src="~/assets/images/cat-1.jpg" alt="نانوسنگ چیست و چه تفاوتی با سنگ طبیعی دارد؟" loading="lazy"><span class="badge badge-soft">دانستنی</span></a><div class="card-body"><div class="card-meta"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg> ۱۴۰۴/۰۴/۲۱</span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> ۵ دقیقه</span></div><h3 class="card-title"><a asp-page="/Article">نانوسنگ چیست و چه تفاوتی با سنگ طبیعی دارد؟</a></h3><p class="card-text">نانوسنگ نه سنگ طبیعی است و نه سرامیک؛ یک کامپوزیت معدنی با پوشش نانو است که خواص هر دو را ترکیب می‌کند.…</p><a class="link-more" asp-page="/Article">ادامه مطلب <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7"/></svg></a></div></article><article class="card blog-card" data-cat="راهنمای خرید"><a class="card-media" asp-page="/Article"><img src="~/assets/images/hero-1.jpg" alt="راهنمای محاسبه متراژ نما برای سفارش" loading="lazy"><span class="badge badge-soft">راهنمای خرید</span></a><div class="card-body"><div class="card-meta"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg> ۱۴۰۴/۰۴/۰۳</span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> ۷ دقیقه</span></div><h3 class="card-title"><a asp-page="/Article">راهنمای محاسبه متراژ نما برای سفارش</a></h3><p class="card-text">کمتر سفارش دادن یعنی توقف کار و انتظار برای بار دوم؛ بیشتر سفارش دادن یعنی هدر بودجه. محاسبه درست خیلی ساده‌تر از آن است…</p><a class="link-more" asp-page="/Article">ادامه مطلب <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7"/></svg></a></div></article><article class="card blog-card" data-cat="دانستنی"><a class="card-media" asp-page="/Article"><img src="~/assets/images/cat-3.jpg" alt="پنل‌های سه‌بعدی؛ از انتخاب طرح تا اجرا" loading="lazy"><span class="badge badge-soft">دانستنی</span></a><div class="card-body"><div class="card-meta"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg> ۱۴۰۴/۰۳/۱۶</span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> ۶ دقیقه</span></div><h3 class="card-title"><a asp-page="/Article">پنل‌های سه‌بعدی؛ از انتخاب طرح تا اجرا</a></h3><p class="card-text">پنل سه‌بعدی فقط یک دیوارپوش نیست؛ ابزار طراحی نور و حجم است. اگر درست انتخاب شود، دیوار شاخص فضا را می‌سازد.…</p><a class="link-more" asp-page="/Article">ادامه مطلب <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7"/></svg></a></div></article></div>
  </div>
</section>
