@page
@model JobModel
@{
    ViewData["Title"] = "جزئیات موقعیت شغلی";
    ViewData["Active"] = "about";
}

<section class="page-hero">
  <div class="container">
    <div class="ph-inner">
      <h1 class="ph-title">طراح فنی صفحات کورین و کوارتز</h1>
      <p class="ph-sub">دفتر فنی — تهران – چهاردانگه — تمام‌وقت</p>
    </div>
  </div>
</section>
<nav class="breadcrumb-wrap" aria-label="مسیر صفحه">
  <div class="container">
    <ol class="breadcrumb"><li><a asp-page="/Index">صفحه اصلی</a></li><li><a asp-page="/Careers">فرصت‌های شغلی</a></li><li aria-current="page">طراح فنی صفحات کورین و کوارتز…</li></ol>
  </div>
</nav>
<section class="section">
  <div class="container job-layout">
    <div class="job-main">
      <div class="card job-summary">
        <ul>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V4h10v17M14 9h6v12M7 8h4M7 12h4M7 16h4M17 13h1M17 17h1"/></svg><span>دپارتمان</span><strong>دفتر فنی</strong></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg><span>محل کار</span><strong>تهران – چهاردانگه</strong></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg><span>سابقه مورد نیاز</span><strong>۳ سال سابقه</strong></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h12v4"/><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M17 13h.01"/></svg><span>حقوق</span><strong>۲۵ تا ۳۵ میلیون تومان</strong></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>نوع همکاری</span><strong>تمام‌وقت</strong></li>
        </ul>
      </div>
      <div class="prose">
        <h2>شرح موقعیت شغلی</h2>
        <p>مسئولیت تهیه نقشه‌های برش، جزئیات اجرایی و نقشه‌های تفصیلی سینک و کانترهای یکپارچه برای پروژه‌ها.</p>
        <h3>وظایف اصلی</h3>
        <ul><li>تهیه نقشه برش صفحات با AutoCAD</li><li>طراحی جزئیات اتصال بدون درز</li><li>هماهنگی با خط CNC برای تولید</li><li>بازبینی نقشه معماران و ارائه پیشنهاد فنی</li></ul>
        <h3>شرایط مورد نیاز</h3>
        <ul><li>تسلط به AutoCAD و SketchUp</li><li>آشنایی با متره و برآورد صفحات</li><li>دقت بالا و پیگیری منظم</li><li>کار تیمی با واحد اجرا</li></ul>
        <h3>مزایای این موقعیت</h3>
        <ul>
          <li>بیمه تأمین اجتماعی از روز اول و بیمه تکمیلی</li>
          <li>محیط کاری فنی و آموزش مستمر نرم‌افزاری و تخصصی</li>
          <li>امکان رشد به موقعیت سرپرست دفتر فنی در ۲۴ ماه</li>
          <li>سرویس رفت‌وآمد و ناهار در محل کارخانه</li>
        </ul>
        <div class="info-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 2 20h20L12 3Z"/><path d="M12 9v5m0 3h.01"/></svg><p><strong>فرآیند جذب:</strong> بررسی رزومه (۳ روز کاری) ← تماس تلفنی ← مصاحبه فنی ← مصاحبه منابع انسانی ← پیشنهاد همکاری. نتیجه همه مراحل به ایمیل شما اطلاع داده می‌شود.</p></div>
      </div>
      <form class="card form-card js-form" id="applyForm" novalidate>
        <h3 class="card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21V9m0 0-4 4m4-4 4 4M4 4h16"/></svg> ارسال رزومه</h3>
        <div class="form-grid">
          <div class="field full"><label>موقعیت مورد نظر</label><select id="jobPosition">
            <option>کارشناس فروش محصولات ساختمانی</option><option>طراح فنی صفحات کورین و کوارتز</option>
            <option>کارشناس CRM و پرتال مشتریان</option><option>سرپرست خط تولید نانوسنگ</option></select></div>
          <div class="field"><label>نام و نام خانوادگی</label><input type="text" required></div>
          <div class="field"><label>شماره همراه</label><input type="tel" required></div>
          <div class="field"><label>ایمیل</label><input type="email" required></div>
          <div class="field"><label>سال‌های سابقه کار</label><select><option>۱ تا ۲ سال</option><option>۲ تا ۴ سال</option><option>۴ تا ۷ سال</option><option>بیش از ۷ سال</option></select></div>
          <div class="field full"><label>فایل رزومه (PDF، حداکثر ۵ مگابایت)</label>
            <div class="file-drop js-file-drop"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21V9m0 0-4 4m4-4 4 4M4 4h16"/></svg><span>فایل رزومه خود را انتخاب کنید</span><input type="file" hidden></div></div>
          <div class="field full"><label>معرفی کوتاه و انگیزه شما برای این موقعیت</label><textarea rows="4"></textarea></div>
        </div>
        <div class="form-actions"><button class="btn btn-primary btn-lg" type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h11l3 3v15H5z"/><path d="M8 3v6h7V3M8 14h8v7H8z"/></svg> ارسال رزومه</button></div>
      </form>
    </div>
    <aside class="job-side">
      <div class="card side-help">
        <span class="svc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.4 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg></span>
        <h3>سؤالی دارید؟</h3>
        <p>واحد منابع انسانی عصرجدید، شنبه تا چهارشنبه ۹ تا ۱۶ پاسخ‌گوی شماست.</p>
        <a class="btn btn-outline btn-block" href="tel:+989159861216"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.4 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg> تماس با منابع انسانی</a>
      </div>
      <div class="card">
        <h3 class="card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7v18h10V6l-3-3Z"/><path d="M14 3v3h3M9 13h6M9 17h6"/></svg> موقعیت‌های دیگر</h3>
        <ul class="side-nav"><li><a href="#applyForm" data-job="کارشناس فروش محصولات ساختمانی">کارشناس فروش محصولات ساختمانی<span>تمام‌وقت</span></a></li><li><a href="#applyForm" data-job="طراح فنی صفحات کورین و کوارتز">طراح فنی صفحات کورین و کوارتز<span>تمام‌وقت</span></a></li><li><a href="#applyForm" data-job="کارشناس CRM و پرتال مشتریان">کارشناس CRM و پرتال مشتریان<span>تمام‌وقت</span></a></li><li><a href="#applyForm" data-job="سرپرست خط تولید نانوسنگ">سرپرست خط تولید نانوسنگ<span>تمام‌وقت</span></a></li></ul>
      </div>
      <div class="card">
        <h3 class="card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2 21c0-3.5 3.1-5.5 7-5.5s7 2 7 5.5"/><path d="M17 5.5a3.5 3.5 0 0 1 0 7M18.5 15c2.2.6 3.5 2.2 3.5 4.5"/></svg> تیم ما در یک نگاه</h3>
        <ul class="check-list">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg> تکمیل فرم همین صفحه و بارگذاری رزومه</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg> تماس کارشناس منابع انسانی برای هماهنگی مصاحبه</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg> اعلام نتیجه پس از بررسی رزومه و مصاحبه</li>
        </ul>
      </div>
    </aside>
  </div>
</section>
