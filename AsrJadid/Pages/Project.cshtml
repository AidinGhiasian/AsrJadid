@page
@model ProjectModel
@{
    ViewData["Title"] = "جزئیات پروژه";
    ViewData["Active"] = "projects";
}

<section class="page-hero" style="--ph-img:url(/assets/images/hero-1.jpg)">
  <div class="container">
    <div class="ph-inner">
      <h1 class="ph-title">ویلای دوبلکس لواسان</h1>
      <p class="ph-sub">نما و محوطه — لواسان — ۱۴۰۳</p>
    </div>
  </div>
</section>
<nav class="breadcrumb-wrap" aria-label="مسیر صفحه">
  <div class="container">
    <ol class="breadcrumb"><li><a asp-page="/Index">صفحه اصلی</a></li><li><a asp-page="/Projects">پروژه‌ها</a></li><li aria-current="page">ویلای دوبلکس لواسان</li></ol>
  </div>
</nav>
<section class="section">
  <div class="container">
    <div class="pj-facts">
      <div class="pf-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg><span>کارفرما</span><strong>کارفرمای خصوصی</strong></div>
      <div class="pf-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg><span>موقعیت</span><strong>لواسان</strong></div>
      <div class="pf-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"/></svg><span>متراژ اجرا</span><strong>۱۴۰۰ مترمربع</strong></div>
      <div class="pf-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg><span>سال اجرا</span><strong>۱۴۰۳</strong></div>
      <div class="pf-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 13 9 5 9-5"/></svg><span>گروه محصول</span><strong>نما و محوطه</strong></div>
    </div>
    <div class="pj-layout">
      <div class="pj-main">
        <h2>شرح پروژه</h2>
        <p>اجرای نمای تراورتن کرم نانوسنگ روی کل بدنه ویلای دوبلکس، همراه با دیوار محوطه و آب‌نما. پروژه در ۴۵ روز کاری با تیم اجرایی خودمان تحویل داده شد.</p>
        <p>در این پروژه، ابتدا بازدید فنی و متره دقیق انجام شد و نقشه برش صفحات تهیه گردید. با توجه به جهت رگه‌ها و ارتفاع دیوارها، چیدمان به‌گونه‌ای طراحی شد که هدر برش به کمترین میزان برسد. سپس بارها در سه مرحله و مطابق برنامه زمانی کارفرما به محل پروژه ارسال شد تا تداخلی با سایر عوامل اجرایی ایجاد نشود.</p>
        <h3>خروجی پروژه</h3>
        <ul class="check-list">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg> کاهش ۱۲٪ هدر برش نسبت به برآورد اولیه</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg> اجرای همزمان بخش نما و محوطه در ۴۵ روز کاری</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg> تحویل با فرم رضایت کارفرما و ضمانت‌نامه کتبی</li>
        </ul>
        <div class="pj-gallery"><a class="pj-shot js-lightbox" href="~/assets/images/hero-1.jpg"><img src="~/assets/images/hero-1.jpg" alt="ویلای دوبلکس لواسان" loading="lazy"></a><a class="pj-shot js-lightbox" href="~/assets/images/cat-1.jpg"><img src="~/assets/images/cat-1.jpg" alt="ویلای دوبلکس لواسان" loading="lazy"></a><a class="pj-shot js-lightbox" href="~/assets/images/p-2.jpg"><img src="~/assets/images/p-2.jpg" alt="ویلای دوبلکس لواسان" loading="lazy"></a></div>
      </div>
      <aside class="pj-side">
        <div class="side-card">
          <h3 class="side-title-static"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.5 7.2L4 21l1.8-5.5A8 8 0 1 1 21 12Z"/></svg> پروژه مشابه دارید؟</h3>
          <p class="card-text">کارشناسان ما می‌توانند برآورد متراژ و هزینه پروژه شما را تهیه کنند.</p>
          <a class="btn btn-primary btn-block" asp-page="/Contact">درخواست مشاوره</a>
          <a class="btn btn-outline btn-block" href="tel:+989159861216"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.4 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg> ۰۹۱۵۹۸۶۱۲۱۶</a>
        </div>
        <div class="side-card">
          <h3 class="side-title-static"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V4h10v17M14 9h6v12M7 8h4M7 12h4M7 16h4M17 13h1M17 17h1"/></svg> پروژه‌های دیگر</h3>
          <div class="pj-mini-list"><a class="pj-mini" asp-page="/Project"><img src="~/assets/images/cat-2.jpg" alt="لابی برج مسکونی نگین"><span>لابی برج مسکونی نگین</span></a><a class="pj-mini" asp-page="/Project"><img src="~/assets/images/cat-3.jpg" alt="رستوران زنجیره‌ای تراس"><span>رستوران زنجیره‌ای تراس</span></a><a class="pj-mini" asp-page="/Project"><img src="~/assets/images/cat-6.jpg" alt="مجتمع تجاری ستاره شهر"><span>مجتمع تجاری ستاره شهر</span></a></div>
        </div>
      </aside>
    </div>
  </div>
</section>
<section class="section section-soft">
