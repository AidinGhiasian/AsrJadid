@using Services.Application
@using Services.Models
@inject IAuthHelper AuthHelper
@inject IAccountApplication AccountApplication
@{
    var accountId = AuthHelper.CurrentAccountId();
    var account = accountId > 0 ? AccountApplication.GetById(accountId) : null;

    var fullName = ((account?.Name ?? string.Empty) + " " + (account?.Family ?? string.Empty)).Trim();
    if (string.IsNullOrWhiteSpace(fullName))
    {
        fullName = "کاربر عصرجدید";
    }

    var active = ViewData["PanelActive"] as string ?? string.Empty;
    var initials = new string(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(x => x[0]).Take(2).ToArray());
}

<aside class="panel-side">
    <div class="ps-user">
        <span class="avatar avatar-xl">
            @if (!string.IsNullOrWhiteSpace(account?.Picture))
            {
                <img src="@account.Picture.ImageUrl()" alt="@fullName">
            }
            else
            {
                @initials
            }
        </span>
        <div>
            <strong>@fullName</strong>
            <small>@(string.IsNullOrWhiteSpace(account?.Role) ? "کاربر" : account.Role)</small>
        </div>
    </div>
    <ul class="ps-nav">
        <li><a class="@(active == "dashboard" ? "active" : "")" asp-page="/Dashboard"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h7v7H4zM13 4h7v16h-7zM4 13h7v7H4z" /></svg><span>داشبورد</span><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg></i></a></li>
        <li><a class="@(active == "orders" ? "active" : "")" asp-page="/Orders"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.5" /><circle cx="18" cy="20" r="1.5" /><path d="M2 3h2.2l2.4 12.2a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 2-1.6L21 7H5" /></svg><span>سفارش‌های من</span><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg></i></a></li>
        <li><a class="@(active == "wishlist" ? "active" : "")" asp-page="/Wishlist"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-9.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 7 3.5C19 15.6 12 20 12 20Z" /></svg><span>علاقه‌مندی‌ها</span><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg></i></a></li>
        <li><a class="@(active == "compare" ? "active" : "")" asp-page="/Compare"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16m0 0-3-3m3 3 3-3M17 20V4m0 0-3 3m3-3 3 3" /></svg><span>مقایسه محصولات</span><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg></i></a></li>
        <li class="side-group">حساب کاربری</li>
        <li><a class="@(active == "profile" ? "active" : "")" asp-page="/Profile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6" /></svg><span>اطلاعات حساب</span><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg></i></a></li>
        <li><a asp-page="/Logout"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 4H5v16h5M15 8l4 4-4 4M19 12H9" /></svg><span>خروج از حساب</span><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg></i></a></li>
    </ul>
    <div class="ps-help">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.4-1 .9-1 1.7M12 17h.01" /></svg>
        <p>پشتیبانی سفارش‌ها</p>
        <a href="tel:+989159861216">۰۹۱۵۹۸۶۱۲۱۶</a>
    </div>
</aside>
